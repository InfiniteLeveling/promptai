{
  "name": "promptarchitect-ai",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Pre-Compilation Requirements & Prompt Orchestration Engine",
  "workspaces": [
    "frontend",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:all": "npx concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:fastify\" \"npm run dev\"",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix frontend run build",
    "build:packages": "npm --workspace=@promptarchitect/contracts run build && npm --workspace=@promptarchitect/compiler run build",
    "vercel-build": "npm --prefix frontend run build",
    "start": "node server/index.js",
    "start:fastify": "npx tsx src/server.ts",
    "dev:fastify": "npx tsx watch src/server.ts",
    "worker": "npx tsx src/modules/jobs/workerRunner.ts",
    "migrate:legacy": "npx tsx scripts/migrate-legacy.ts",
    "verify:legacy": "npx tsx scripts/verify-migration.ts",
    "verify:gates": "npx tsx scripts/verify-production-gates.ts",
    "preview": "npm --prefix frontend run preview",
    "test:contracts": "npm --workspace=@promptarchitect/contracts run test",
    "test:compiler": "npm --workspace=@promptarchitect/compiler run test",
    "test:schema": "vitest run tests/schema.test.ts",
    "test:rls": "vitest run tests/rls.test.ts",
    "test:quota": "vitest run tests/quota.test.ts",
    "test:server": "vitest run tests/server.test.ts",
    "test:auth": "vitest run tests/auth.test.ts",
    "test:repositories": "vitest run tests/repositories.test.ts",
    "test:providers": "vitest run tests/providers.test.ts",
    "test:idempotency": "vitest run tests/idempotency.test.ts",
    "test:compilation": "vitest run tests/compilation.test.ts",
    "test:billing-storage": "vitest run tests/billing_storage.test.ts",
    "test:jobs": "vitest run tests/jobs.test.ts",
    "test:deletion": "vitest run tests/deletion.test.ts",
    "test:compatibility": "vitest run tests/compatibility.test.ts",
    "test:migration": "vitest run tests/migration.test.ts",
    "test:resilience": "vitest run tests/resilience.test.ts",
    "test:gates": "vitest run tests/production_gates.test.ts",
    "test:canary": "vitest run tests/canary.test.ts",
    "test": "npm run test:contracts && npm run test:compiler && npm run test:schema && npm run test:rls && npm run test:quota && npm run test:server && npm run test:auth && npm run test:repositories && npm run test:providers && npm run test:idempotency && npm run test:compilation && npm run test:billing-storage && npm run test:jobs && npm run test:deletion && npm run test:compatibility && npm run test:migration && npm run test:resilience && npm run test:gates && npm run test:canary"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/type-provider-zod": "^1.0.0",
    "@promptarchitect/compiler": "*",
    "@promptarchitect/contracts": "*",
    "@google/genai": "^2.21.0",
    "@octokit/rest": "^21.1.1",
    "@supabase/supabase-js": "^2.115.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fastify": "^5.12.3",
    "fastify-raw-body": "^6.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  }
}

# =====================================================================
# PromptArchitect AI — Production Backend Environment Variables
# Copy this file to .env in your root directory and fill in your values
# =====================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Managed Backend (https://supabase.com/dashboard)
# Found in: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Direct PostgreSQL Connection (Optional for direct DB pool)
# Found in: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Google Gemini AI (https://aistudio.google.com/)
AI_API_KEY=your_gemini_api_key_here
AI_PRIMARY_MODEL=gemini-1.5-flash
AI_FALLBACK_MODEL=gemini-1.5-pro

# GitHub Ingestion (Optional - for /api/ingest/github)
# Generate from: https://github.com/settings/tokens (public_repo scope)
GITHUB_TOKEN=ghp_your_github_token_here

# Stripe Billing & Subscriptions (Optional for local development)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_DEV_PRICE_ID=price_dev_monthly

# Storage Buckets (Configured in Supabase Storage)
STORAGE_BUCKET_ATTACHMENTS=prompt-attachments
STORAGE_BUCKET_AVATARS=user-avatars

# Background Compilation Worker
WORKER_ID=compilation-worker-01
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=60
WORKER_STALE_CHECK_MS=60000
